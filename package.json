{
  "name": "gabriel-audio-study-mvp",
  "private": true,
  "version": "0.1.0",
  "description": "PWA privada para transformar PDF/texto em áudio de estudo com OpenAI TTS.",
  "scripts": {
    "install:all": "npm --prefix server install && npm --prefix client install",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start",
    "test:study": "node --test study/tests/*.test.mjs",
    "study:validate": "node study/scripts/validate-all.mjs",
    "study:export": "node study/scripts/export-topic.mjs",
    "study:reading": "node study/scripts/export-reading.mjs",
    "study:rag": "node study/scripts/export-rag-staging.mjs",
    "study:channels": "node study/scripts/export-channels.mjs",
    "study:session": "node study/scripts/export-session-csv.mjs"
  }
}
